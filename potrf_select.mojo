# Generated by gen_potrf_select.py from the tuning runs in
# tune-potrf/ (sh tune-potrf.sh).  Do not edit.
#
# potrf_select[SME, ACC](n) -> (algorithm, nthreads, nb): the
# configuration potrf uses for nthreads = 0.  Algorithm: 0 tiles
# and tasks, 1 pack once (potrf_pk), 2 pack once with lookahead
# (potrf_pk3).


def potrf_select[SME: Bool, ACC: Int](n: Int) -> Tuple[Int, Int, Int]:
    comptime if SME and ACC == 0:
        if n <= 75:  # pk, n >= 0
            return (1, 1, 0)
        if n <= 1625:  # pk3, n >= 76
            return (2, 2, 0)
        if n <= 2750:  # pk, n >= 1626
            return (1, 1, 0)
        if n <= 3250:  # tiles, n >= 2751
            return (0, 3, 384)
        if n <= 3750:  # tiles, n >= 3251
            return (0, 3, 256)
        return (0, 4, 256)  # tiles, n >= 3751
    comptime if SME and ACC == 1:
        if n <= 75:  # tiles, n >= 0
            return (0, 1, 512)
        if n <= 175:  # tiles, n >= 76
            return (0, 1, 256)
        if n <= 225:  # tiles, n >= 176
            return (0, 1, 512)
        if n <= 275:  # tiles, n >= 226
            return (0, 1, 4096)
        if n <= 350:  # tiles, n >= 276
            return (0, 1, 512)
        if n <= 450:  # tiles, n >= 351
            return (0, 1, 4096)
        if n <= 575:  # tiles, n >= 451
            return (0, 2, 128)
        if n <= 725:  # tiles, n >= 576
            return (0, 4, 128)
        if n <= 1125:  # tiles, n >= 726
            return (0, 2, 256)
        if n <= 1375:  # tiles, n >= 1126
            return (0, 4, 128)
        if n <= 1875:  # tiles, n >= 1376
            return (0, 3, 256)
        if n <= 2250:  # tiles, n >= 1876
            return (0, 4, 128)
        if n <= 2750:  # tiles, n >= 2251
            return (0, 2, 384)
        if n <= 3250:  # tiles, n >= 2751
            return (0, 4, 512)
        if n <= 3750:  # tiles, n >= 3251
            return (0, 2, 512)
        return (0, 4, 512)  # tiles, n >= 3751
    # not tuned (other backends, or no tuning data)
    return (0, 1, 4096) if n <= 1000 else (0, 4, 256)
